# Database
DATABASE_URL="mysql://user:password@localhost:3306/ukride"

# Google Maps / Places (public)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Public URL for Revolut return redirect (NOT localhost). Pick one approach:

# A) Laragon — use ukride.test:3000 (simplest; restart dev after changing):
NEXT_PUBLIC_APP_URL=http://ukride.test:3000

# A2) Laragon port 80 — enable Apache mod_proxy and use repo root .htaccess, then:
# NEXT_PUBLIC_APP_URL=http://ukride.test

# B) localhost:3000 in browser — use ngrok for Revolut only:
# Run: ngrok http 3000
# REVOLUT_REDIRECT_BASE_URL=https://YOUR-ID.ngrok-free.app

# Revolut Merchant API (Business → Merchant API → Secret key)
REVOLUT_MERCHANT_SECRET_KEY=
REVOLUT_ENV=sandbox
REVOLUT_API_VERSION=2024-09-01

# NextAuth (customer + admin login)
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://ukride.test:3000

# Auth / JWT secrets (generate long random strings; keep secret)
AUTH_SECRET=generate-a-long-random-string
DRIVER_JWT_SECRET=generate-a-long-random-string

# Admin
ADMIN_EMAIL=admin@example.com

# Email (Resend — get key at resend.com → API Keys)
RESEND_API_KEY=
EMAIL_FROM="London Airport Taxi Services <noreply@yourdomain.co.uk>"
# Optional: while the sending domain isn't verified on Resend, deliveries are
# forced to this address (use your own inbox for testing).
RESEND_TEST_EMAIL=

# HERE Maps (fallback address autocomplete/geocoding — developer.here.com)
NEXT_PUBLIC_HERE_API_KEY=

# Revolut redirect base (public https URL; ngrok in dev, real domain in prod)
# REVOLUT_REDIRECT_BASE_URL=https://YOUR-ID.ngrok-free.app

# Dev-only: expose password-reset token in the mobile flow (leave unset in prod)
# MOBILE_DEV_SHOW_RESET_TOKEN=1

# ── Production note (Cloudways) ────────────────────────────────────────────
# On the live server set REVOLUT_ENV=production, NEXT_PUBLIC_APP_URL and
# NEXTAUTH_URL to https://londonairporttaxiservices.co.uk, and use live keys.
# NEXT_PUBLIC_* vars are baked in at build time → rebuild after changing them.
