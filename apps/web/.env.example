# Database
DATABASE_URL="mysql://user:password@localhost:3306/ukride"

# Geoapify (myprojects.geoapify.com → API key; free plan, no card). Server-side only:
# prices route distances, powers address autocomplete and the route-map tiles.
# Unset/invalid → no address suggestions, no map, and every journey is priced as 28 miles.
GEOAPIFY_API_KEY=

# Public site URL — used for Stripe success/cancel redirects and login callbacks.
# localhost is fine in Stripe test mode.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys). Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Stripe (Dashboard → Developers → Webhooks → endpoint …/api/payments/stripe/webhook → Signing secret)
# Locally: `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook` prints a whsec_… secret.
STRIPE_WEBHOOK_SECRET=

# Hosted MySQL over TLS (e.g. Aiven): set DATABASE_SSL=true and paste the provider CA (PEM) below.
# DATABASE_SSL=true
# DATABASE_SSL_CA=

# NextAuth (customer + admin login)
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Auth / JWT secrets (generate long random strings; keep secret)
AUTH_SECRET=generate-a-long-random-string
DRIVER_JWT_SECRET=generate-a-long-random-string

# Admin
ADMIN_EMAIL=admin@example.com

# Email (Resend — get key at resend.com → API Keys)
RESEND_API_KEY=
EMAIL_FROM="MRM Executive Voyage <noreply@yourdomain.co.uk>"
# Optional: while the sending domain isn't verified on Resend, deliveries are
# forced to this address (use your own inbox for testing).
RESEND_TEST_EMAIL=


# Dev-only: expose password-reset token in the mobile flow (leave unset in prod)
# MOBILE_DEV_SHOW_RESET_TOKEN=1

# ── Production note (Cloudways) ────────────────────────────────────────────
# On the live server set NEXT_PUBLIC_APP_URL and NEXTAUTH_URL to the real https domain,
# and use live Stripe keys (sk_live_… + the live webhook signing secret).
# NEXT_PUBLIC_* vars are baked in at build time → rebuild after changing them.
