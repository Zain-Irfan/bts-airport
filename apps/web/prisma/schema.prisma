generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Users & Auth ───────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  phone     String?    @db.VarChar(32)
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookings  Booking[]

  @@map("users")
}

// ─── Bookings ───────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  userId        String?       @db.VarChar(64)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String
  pickup        String
  dropoff       String
  date          DateTime
  time          String
  passengers    Int           @default(1)
  luggage       Int           @default(0)
  vehicleType   String?
  notes         String?       @db.Text
  fare                Decimal?      @db.Decimal(10, 2)
  /// Return journey date (null = one-way)
  returnDate          DateTime?
  /// Return journey time string, e.g. "14:30"
  returnTime          String?       @db.VarChar(8)
  flightNumber        String?       @db.VarChar(24)
  status              BookingStatus @default(PENDING)
  assignedDriverId    String?       @db.VarChar(64)
  assignedDriver      Driver?       @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([assignedDriverId])
  @@map("bookings")
}

// ─── Revolut checkout sessions ──────────────────────────────

enum PaymentSessionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model PaymentSession {
  id             String               @id @default(cuid())
  revolutOrderId String?              @unique @db.VarChar(64)
  status         PaymentSessionStatus @default(PENDING)
  amountMinor    Int
  currency       String               @default("GBP") @db.VarChar(3)
  payload        String               @db.Text
  bookingId      String?              @db.VarChar(64)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("payment_sessions")
}

// ─── Driver Applications ────────────────────────────────────

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
}

model Driver {
  id                    String       @id @default(cuid())
  fullName              String
  email                 String       @unique
  phone                 String
  /// PCO / taxi licence number (required at registration)
  licenseNumber         String
  /// Public URL path, e.g. /uploads/driver-licenses/abc.jpg
  licenseImageUrl       String?      @db.VarChar(500)
  password              String
  vehicleType           String?
  vehicleModel          String?
  vehiclePlate          String?
  experience            String?
  address               String?      @db.Text
  status                DriverStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewNotes           String?      @db.Text
  passwordResetToken    String?      @unique @db.VarChar(64)
  passwordResetExpires  DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  bookings              Booking[]

  @@map("drivers")
}

// ─── Contact Form Submissions ───────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

// ─── Admin Site Settings (key/value store) ──────────────────

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── Quote vehicle categories (admin-managed filter chips) ─

model VehicleCategory {
  id        String   @id @default(cuid())
  /// Stable key stored on VehicleType.categoryKey (lowercase snake_case)
  slug      String   @unique @db.VarChar(32)
  label     String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_categories")
}

// ─── Quote vehicle tiers (admin-managed) ───────────────────

/// Configurable vehicle categories for the quote step: capacity, image, and fare formula inputs.
model VehicleType {
  id                   String   @id @default(cuid())
  slug                 String   @unique @db.VarChar(64)
  name                 String   @db.VarChar(120)
  subtitle             String?  @db.VarChar(255)
  imageUrl             String?  @db.VarChar(500)
  maxPassengers        Int      @default(4)
  maxHandLuggage       Int      @default(1)
  maxSuitcases         Int      @default(2)
  /// Fixed £ added before distance component
  baseFareGbp          Decimal  @default(0) @db.Decimal(10, 2)
  /// £ per mile (used with route distance for quotes)
  perMileGbp           Decimal  @default(0) @db.Decimal(10, 2)
  minimumFareGbp       Decimal  @default(0) @db.Decimal(10, 2)
  /// If greater than 0, UI can show promo and a crossed-out list price from this discount
  promoDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  /// Must match VehicleCategory.slug
  categoryKey          String   @default("saloon") @db.VarChar(32)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("vehicle_types")
}
